# Base URL of the SaloneFix API. A relative path goes through the Vite dev-server / nginx
# proxy (recommended: works from phones on the same Wi-Fi, no CORS). Use an absolute URL
# only when the API is hosted separately, e.g. https://api.example.sl/api/v1
VITE_API_BASE_URL=/api/v1
# Show one-click demo persona buttons on the login page (disable for UAT/demo with real accounts)
VITE_DEMO_PERSONAS=true
