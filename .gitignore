# --- Python / backend ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Runtime data (regenerated by init_db / uploads) — never commit
backend/salonefix.db
backend/*.db
backend/media_storage/
media_storage/
*.db-journal

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
.vite/

# --- Secrets ---
.env
.env.*
!.env.example

# --- Vendored third-party toolkit (installed into ~/.claude, not part of the app) ---
everything-claude-code/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# --- Claude Code local state ---
.claude/settings.local.json
